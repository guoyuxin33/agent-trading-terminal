    "zod": "^3.25.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
